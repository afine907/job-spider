# Application
APP_NAME=job-spider
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///data/jobs.db

# Spider Settings
SPIDER_CONCURRENCY=3
SPIDER_REQUEST_DELAY_MIN=1.0
SPIDER_REQUEST_DELAY_MAX=3.0
SPIDER_TIMEOUT=30

# Proxy (optional)
PROXY_ENABLED=false
PROXY_LIST_FILE=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console  # console or json
