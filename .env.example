# Application
APP_NAME=job-spider
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///data/jobs.db

# Spider Settings
SPIDER_CONCURRENCY=3
SPIDER_REQUEST_DELAY_MIN=1.0
SPIDER_REQUEST_DELAY_MAX=3.0
SPIDER_TIMEOUT=30

# Proxy (optional)
PROXY_ENABLED=false
PROXY_LIST_FILE=

# Storage Paths
STORAGE_BROWSER_STATE_DIR=data/browser_state
STORAGE_OUTPUT_DIR=output
STORAGE_LOGS_DIR=logs

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console  # console or json
LOG_OUTPUT_PATH=logs/app.log  # optional, logs to console only if not set
LOG_ROTATION=size  # size or time
LOG_MAX_BYTES=10485760  # 10MB, only for rotation=size
LOG_BACKUP_COUNT=7
LOG_ROTATION_WHEN=midnight  # S/M/H/D/midnight, only for rotation=time
LOG_ROTATION_INTERVAL=1  # only for rotation=time
